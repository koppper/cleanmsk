# DJANGO
DJANGO_SECRET_KEY=<your_django_secret_key>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your_domain>
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://<your_domain>
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://<your_domain>
LANGUAGE_CODE=ru-ru
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# PROJECT INFO
PROJECT_NAME=<your_project_name>
ENVIRONMENT=development

# DATABASE
DATABASE_NAME=<your_db_name>
DATABASE_USER=<your_db_user>
DATABASE_PASSWORD=<your_db_password>
DATABASE_HOST=<your_postgres_host>
DATABASE_PORT=5432

# REDIS
REDIS_HOST=<your_redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXPIRE=3600

# TELEGRAM
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>

# CELERY
CELERY_BROKER_URL=redis://<your_redis_host>:6379/0
